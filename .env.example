# ─────────────────────────────────────────────────────────────
# Domain & Traefik
# ─────────────────────────────────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://portfolio:change-me-in-prod@db:5432/portfolio?schema=public

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Web (Next.js)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Container registry (production)
# ─────────────────────────────────────────────────────────────
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# Grafana Cloud (monitoring)
# Grafana Cloud → My Account → Prometheus → Details 에서 확인
# ─────────────────────────────────────────────────────────────
GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-xx.grafana.net/api/prom/push
GRAFANA_USERNAME=your-instance-id
GRAFANA_API_TOKEN=your-grafana-api-token
